# Provider keys — only set the ones you use
CEREBRAS_API_KEY=your_key_here
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=...

# Override model aliases at runtime
VANTAGE_FAST_MODEL=cerebras/gemma2-9b-it
VANTAGE_SYNTHESIS_MODEL=cerebras/deepseek-r1-distill-llama-70b

# For fully local runs (no keys needed)
# VANTAGE_FAST_MODEL=ollama/gemma3:12b
# VANTAGE_SYNTHESIS_MODEL=ollama/deepseek-r1:32b

# Semantic Scholar (optional, increases rate limits)
S2_API_KEY=
